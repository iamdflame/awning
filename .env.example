# Awning — environment. Copy to .env at the repo root (web/ loads it; never commit .env).
# Every provider key is optional: when one is missing, that adapter runs as a clearly
# logged MOCK, so `pnpm dev` works with nothing but the four AWNING_* values below.

# --- Core (required in production) ---------------------------------------------
# Public origin of the API. x402 resource URLs and offer buy links are built from it.
AWNING_API_URL=https://api.awning.sh
# Treasury wallet: payTo for /x402/open (Pro opening fees). Business sales pay the owner directly.
AWNING_TREASURY_ADDRESS=
# Treasury private key: refunds (failures discovered after settlement) and, with
# PORKBUN_PAY_WITH=usdc, paying Porkbun over x402. Never logged. Leave empty to simulate refunds.
AWNING_TREASURY_PRIVATE_KEY=
# Shared secret PayBox injects as the brokered header `x-awning-plugin-key`.
AWNING_PLUGIN_KEY=
# HMAC secret for owner tokens (awn_ot_…). Rotating it revokes every owner token.
AWNING_OWNER_TOKEN_SECRET=

# --- Optional core ---------------------------------------------------------------
# Root domain for free storefronts (<slug>.awning.sh) and the landing host.
AWNING_ROOT_DOMAIN=awning.sh
# Extra hosts that should serve the landing/API instead of a storefront (comma-separated).
AWNING_EXTRA_ROOT_HOSTS=
# x402 facilitator for /verify and /settle (PayAI supports eip155:8453 exact v2 and v1, no key).
# "mock" = verify EIP-3009 signatures locally and settle nothing (development only; refused in production).
AWNING_FACILITATOR_URL=https://facilitator.payai.network
# Base RPC for refunds and on-chain authorizationState checks.
BASE_RPC_URL=https://mainnet.base.org
# Plan (quote) lifetime in seconds. Paid retries get a 5-minute grace after expiry.
AWNING_PLAN_TTL_SECONDS=1800
# Budget for the Pro opening saga before settlement (ms). Settlement adds up to ~12 s.
AWNING_OPEN_DEADLINE_MS=26000
# Trust & safety: per-wallet limits; operator key enables POST /v1/admin/businesses/:slug/status (takedown/restore)
AWNING_PLAN_LIMIT_PER_HOUR=12
AWNING_FREE_OPENS_PER_DAY=3
AWNING_GLOBAL_PLANS_PER_HOUR=300
AWNING_GLOBAL_FREE_OPENS_PER_HOUR=60
# Bearer secret for GET /v1/cron/reconcile (Vercel cron + the scheduled GitHub workflow).
CRON_SECRET=
# Operator paging for refunds that failed, unrecorded orders, interrupted opens and report holds.
# Slack- or Discord-compatible incoming webhook URL, and/or an E.164 phone (needs Twilio + TWILIO_FROM_NUMBER).
AWNING_OPS_WEBHOOK_URL=
AWNING_OPERATOR_PHONE=
AWNING_ADMIN_KEY=

# --- Database ----------------------------------------------------------------------
# Postgres (Neon). Empty → embedded PGlite in web/.data/pglite (auto-migrated).
DATABASE_URL=
# Set to 0 to skip auto-migration on first connection (then run `pnpm db:migrate`).
AWNING_AUTO_MIGRATE=1
# Override the PGlite directory (local only).
AWNING_PGLITE_DIR=

# --- LLM (business drafts) ---------------------------------------------------------
# Anthropic Messages API. Empty → deterministic template drafts.
ANTHROPIC_API_KEY=
# Or Claude through OpenRouter (default anthropic/claude-haiku-5.5, reasoning off: 2.7–4.9 s per draft).
OPENROUTER_API_KEY=
AWNING_OPENROUTER_MODEL=
AWNING_LLM_MODEL=claude-sonnet-5-5
# Budget for the LLM inside POST /v1/plan (domain checks run in parallel). Over budget → template draft.
AWNING_LLM_TIMEOUT_MS=5000

# --- Registrar: Porkbun API v3 -----------------------------------------------------
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
# credit = pay registrations from Porkbun account credit; usdc = pay each one over x402 from the treasury.
PORKBUN_PAY_WITH=credit

# --- Hosting: Vercel Domains API ---------------------------------------------------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# DNS records written at the registrar for a custom domain.
AWNING_DNS_TARGET_A=76.76.21.21
AWNING_DNS_TARGET_CNAME=cname.vercel-dns.com

# --- Phone: Twilio (numbers, TwiML receptionist fallback, owner SMS) -------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sender for owner SMS when the business has no number of its own.
TWILIO_FROM_NUMBER=

# --- AI receptionist: ElevenLabs Conversational AI --------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Testing ------------------------------------------------------------------------
# 1 = force every adapter to its mock (tests/demos), even when keys are set.
AWNING_FORCE_MOCKS=
# Buyer key for `node web/scripts/pay.mjs <url> --yes` (a wallet with a little USDC on Base).
BUYER_PRIVATE_KEY=
